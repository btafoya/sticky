# Copy to .env and fill in real values before running `docker compose up`.

# PostgreSQL superuser password
POSTGRES_PASSWORD=change-me-strong-password

# PostgREST authenticator role password (internal, not exposed to clients)
AUTHENTICATOR_PASSWORD=change-me-authenticator-password

# Shared API key used by Sticky clients via Basic auth (username: sticky, password: this value)
STICKY_API_KEY=change-me-api-key

# Local PostgREST port (change if 3000 is already taken)
PGRST_PORT=3000
